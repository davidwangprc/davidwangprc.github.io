<div class="docs">
  {% if site.docs != blank %}
    {% assign docs_size = site.docs | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and docs_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign docs = site.docs | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign docs_limit = page.announcements.limit %}
        {% else %}
          {% assign docs_limit = docs_size %}
        {% endif %}
        {% for item in docs limit: docs_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="docs-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No docs so far...</p>
  {% endif %}
</div>
